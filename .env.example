# --- Database (Supabase Postgres 연결 문자열) ---
# Supabase 프로젝트 > Settings > Database > Connection string (URI, "Connection pooling" 권장)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Session cookie signing (any random long string) ---
SESSION_SECRET="change-this-to-a-long-random-string"

# --- SMTP (사내 메일 서버 정보로 교체하세요) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="brain-monitor@gccorp.com"

# --- App ---
NEXT_PUBLIC_APP_NAME="BRAiN 제조기록서 반납 모니터링"
